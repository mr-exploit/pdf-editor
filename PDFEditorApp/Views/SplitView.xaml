<UserControl x:Class="PDFEditorApp.Views.SplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PDFEditorApp.ViewModels">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Split PDF" FontSize="22" FontWeight="SemiBold" Foreground="#0078D4" Margin="0,0,0,16"/>

        <!-- File Selection -->
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16" Background="#FAFAFA">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Input PDF File:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding InputFileName}" FontSize="13" Foreground="#555"
                               AutomationProperties.Name="Selected input file name"/>
                    <TextBlock Text="{Binding TotalPages, StringFormat='Total pages: {0}'}" FontSize="12" Foreground="#888" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Browse File" Command="{Binding BrowseInputFileCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"
                        AutomationProperties.Name="Browse input PDF file" ToolTip="Select a PDF file to split"/>
            </Grid>
        </Border>

        <!-- Split Mode -->
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16" Background="#FAFAFA">
            <StackPanel>
                <TextBlock Text="Split Mode:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <RadioButton Content="Split per page (each page becomes a separate file)"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:SplitMode.PerPage}}"
                             FontSize="13" Margin="0,0,0,8"
                             AutomationProperties.Name="Split per page mode"/>
                <RadioButton Content="Split by page ranges"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:SplitMode.ByRange}}"
                             FontSize="13" Margin="0,0,0,8"
                             AutomationProperties.Name="Split by range mode"/>
                <Grid Margin="20,0,0,8" Visibility="{Binding SelectedMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static vm:SplitMode.ByRange}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Ranges (e.g. 1-3, 4-7, 8):" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding RangeInput, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" FontSize="13" BorderBrush="#DDD"
                             AutomationProperties.Name="Page ranges input" ToolTip="Enter page ranges like: 1-3, 4-7, 8"/>
                </Grid>
                <RadioButton Content="Split every N pages"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:SplitMode.EveryNPages}}"
                             FontSize="13" Margin="0,0,0,8"
                             AutomationProperties.Name="Split every N pages mode"/>
                <Grid Margin="20,0,0,0" Visibility="{Binding SelectedMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static vm:SplitMode.EveryNPages}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Pages per chunk:" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding PagesPerChunk, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" FontSize="13" BorderBrush="#DDD"
                             AutomationProperties.Name="Pages per chunk"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Output Settings -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="File Prefix:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
            <TextBox Grid.Column="1" Text="{Binding FilePrefix, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4" FontSize="13" BorderBrush="#DDD"
                     AutomationProperties.Name="File prefix for output files"/>
            <TextBlock Grid.Column="2" Text="Output Folder:" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="13"/>
            <TextBox Grid.Column="3" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4" FontSize="13" BorderBrush="#DDD"/>
            <Button Grid.Column="4" Content="Browse" Command="{Binding BrowseOutputFolderCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
        </Grid>

        <!-- Preview -->
        <Border Grid.Row="4" Background="#F5F5F5" CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <TextBlock Text="{Binding PreviewText}" FontSize="13" Foreground="#555"
                       AutomationProperties.Name="Split preview information"/>
        </Border>

        <ProgressBar Grid.Row="5" Value="{Binding SplitProgress}" Maximum="100" Height="16" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12" Foreground="#666"/>
            <Button Content="Open Output Folder" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Cancel" Command="{Binding CancelSplitCommand}" IsEnabled="{Binding IsBusy}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="&#x25B6; Split" Command="{Binding StartSplitCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    AutomationProperties.Name="Start split" ToolTip="Start splitting the PDF"/>
        </StackPanel>
    </Grid>
</UserControl>
