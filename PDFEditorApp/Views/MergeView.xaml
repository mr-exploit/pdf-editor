<UserControl x:Class="PDFEditorApp.Views.MergeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Merge PDF" FontSize="22" FontWeight="SemiBold" Foreground="#0078D4" Margin="0,0,0,16"/>

        <!-- Drop Zone -->
        <Border Grid.Row="1" BorderBrush="#0078D4" BorderThickness="2" CornerRadius="8"
                Background="#F0F8FF" Padding="20" Margin="0,0,0,8"
                AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#x1F517;" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="Drag &amp; Drop PDF files here" FontSize="14" HorizontalAlignment="Center" Foreground="#555" Margin="0,8,0,4"/>
                <Button Content="Add Files" Command="{Binding AddFilesCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Add PDF files to merge"/>
            </StackPanel>
        </Border>

        <!-- File List with reorder buttons -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ListView Grid.Column="0" x:Name="FileListView" ItemsSource="{Binding Files}" BorderBrush="#DDD" BorderThickness="1">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="File Name" Width="280" DisplayMemberBinding="{Binding FileName}"/>
                        <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding FileSizeDisplay}"/>
                        <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding Status}"/>
                        <GridViewColumn Header="" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#x2715;" Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="#D32F2F" FontSize="14" Cursor="Hand"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                <Button Content="&#x25B2;" Command="{Binding MoveUpCommand}"
                        CommandParameter="{Binding ElementName=FileListView, Path=SelectedItem}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Width="36" Height="36"
                        ToolTip="Move up" AutomationProperties.Name="Move file up"/>
                <Button Content="&#x25BC;" Command="{Binding MoveDownCommand}"
                        CommandParameter="{Binding ElementName=FileListView, Path=SelectedItem}"
                        Style="{StaticResource SecondaryButtonStyle}" Width="36" Height="36"
                        ToolTip="Move down" AutomationProperties.Name="Move file down"/>
            </StackPanel>
        </Grid>

        <!-- Output Path -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Output File:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13"/>
            <TextBox Grid.Column="1" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4" FontSize="13" BorderBrush="#DDD"
                     AutomationProperties.Name="Output file path"/>
            <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseOutputPathCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
        </Grid>

        <ProgressBar Grid.Row="4" Value="{Binding MergeProgress}" Maximum="100" Height="16" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12" Foreground="#666"/>
            <Button Content="Clear" Command="{Binding ClearFilesCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Open Result" Command="{Binding OpenOutputFileCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                    ToolTip="Open the merged PDF file" AutomationProperties.Name="Open merged PDF"/>
            <Button Content="Cancel" Command="{Binding CancelMergeCommand}" IsEnabled="{Binding IsBusy}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="&#x25B6; Merge" Command="{Binding StartMergeCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    AutomationProperties.Name="Start merge" ToolTip="Start merging PDF files"/>
        </StackPanel>
    </Grid>
</UserControl>
